# ==============================================================================
# Twolander — Production Environment Variables
# ==============================================================================

# 1. Database (Turso SQLite at the Edge)
# Local: file:./dev.db (no token needed)
# Production: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=libsql://twolander-example.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token

# 2. Session Encryption (nuxt-auth-utils)
# Generate with: openssl rand -hex 32 (must be 32+ random characters)
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters-here

# 3. Google OAuth & Calendar Sync (Google Cloud Console)
# Redirect URI: https://your-domain.vercel.app/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 4. Google Gemini 2.5 Flash (AI Natural Language Scheduler)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 5. Public App URL (Used for partner invite links & QR codes)
NUXT_PUBLIC_APP_URL=https://twolander.vercel.app
